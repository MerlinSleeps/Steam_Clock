		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "(Ich werde langsam echt gut darin. Fühlt sich fast so an als hätte ich das Ganze schon dutzende Male gemacht)"
		},
		{
			"event_id": "dialogic_013"
		},
