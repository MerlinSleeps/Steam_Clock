			"event_id": "dialogic_013"
		},
		{
			"character": "character-1648722526.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Kein Dank notwendig. Ich war letzlich nur anwesend, während sie es mit gekonnten Handgriffen geschafft haben."
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Wie du meinst. Na denn, sollen wir zum Lord zurück?"
