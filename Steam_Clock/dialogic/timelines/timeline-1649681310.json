		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Hervorragend Wilson! Das wars das Haus sollte wieder Strom haben. Ohne dich hätte ich es nicht geschafft."
		},
		{
			"character": "character-1648722526.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ich möchte nur eines klarstellen. Es ist mir durchaus klar, dass sie durchaus im Stande sind solche Tätigkeiten im Alleingang zu bewältigen."
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Nunja, ich wollte nur..."
		},
		{
			"character": "character-1648722526.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Es ist okay, Alendra. Ich danke dir."
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Wilson? Hast du mich gerade gedutzt? "
		},
		{
			"character": "character-1648722526.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ist dem so? Sie müssen sich wohl verhört haben. Nun denn wollen wir uns zurück zum Grafen gehen?"
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Sehr gern doch."
		},
