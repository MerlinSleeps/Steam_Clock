			"wait_seconds": 1
		},
		{
			"animation": "back_in_down.gd",
			"animation_length": 2,
			"animation_wait": true,
			"change_mirror_portrait": false,
			"change_z_index": false,
			"character": "character-1638131868.json",
			"event_id": "dialogic_002",
			"mirror_portrait": false,
			"portrait": "Default",
			"portrait_definition": "",
			"position": {
				"0": false,
