		{
			"character": "character-1648720722.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Ah da seid ihr ja wieder ihr jungen Hüpfer! Und sprecht! Kann ich endlich wieder meine Kronleuchter anschalten?"
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Sehen sie selbst."
		},
		{
			"audio": "play",
			"audio_bus": "Master",
			"event_id": "dialogic_030",
