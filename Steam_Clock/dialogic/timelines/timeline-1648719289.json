		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "War das jetzt besser Willson?"
		},
		{
			"character": "character-1648722526.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "[speed=20]....................  [speed=1]Ausgezeichnet meine Dame."
		},
		{
			"choice": "Klingeln",
			"condition": ">",
