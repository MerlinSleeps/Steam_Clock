			"value": "0"
		},
		{
			"character": "character-1638131868.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "(Hmm. Da war doch was. Willson meinte doch ich sollte doch die Klingel benutzen. Aber wann hat er mir das gesagt?) "
		},
