[gd_scene load_steps=3 format=2]

[ext_resource path="res://addons/dialogic/Nodes/ChoiceButton.gd" type="Script" id=1]
[ext_resource path="res://Scenes/SliderButton.tscn" type="PackedScene" id=2]

[node name="ChoiceButton" type="Button"]
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Testing button "
script = ExtResource( 1 )

[node name="SliderButton" parent="." instance=ExtResource( 2 )]

[node name="Timer" type="Timer" parent="."]

[connection signal="mouse_entered" from="." to="." method="_on_ChoiceButton_mouse_entered"]
[connection signal="mouse_exited" from="." to="." method="_on_ChoiceButton_mouse_exited"]
[connection signal="bar_filled" from="SliderButton" to="." method="_on_Control_bar_filled"]
[connection signal="timeout" from="Timer" to="." method="_on_Timer_timeout"]
